<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.caps</groupId>
    <artifactId>exeris-caps-jwt-validation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Exeris Caps :: JWT Admission Policy</name>
    <description>
        JWT admission capability: verifies EdDSA (and, when configured, RS256) access tokens against the
        issuer's JWKS and records the verified principal for the Service Boundary request.
        Owns no transport and binds to no host runtime.
    </description>
    <url>https://github.com/exeris-systems/exeris-caps-jwt-validation</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Exeris Commercial License</name>
            <url>https://exeris.eu/licenses/commercial-1.1.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exeris.sdk.version>0.12.0</exeris.sdk.version>
        <exeris.kernel.version>0.13.0-SNAPSHOT</exeris.kernel.version>
        <exeris.tooling.version>0.10.0</exeris.tooling.version>
        <exeris.caps.service-boundary-core.version>0.1.0-SNAPSHOT</exeris.caps.service-boundary-core.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
            <version>${exeris.sdk.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- provided: the composition runtime that drives the lifecycle supplies these hooks -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-lifecycle</artifactId>
            <version>${exeris.sdk.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- provided and optional: service-boundary-core is one of two admission hosts (ADR-099 obligation 4);
             a composition that binds the filter chain supplies it -->
        <dependency>
            <groupId>eu.exeris.caps</groupId>
            <artifactId>exeris-caps-service-boundary-core</artifactId>
            <version>${exeris.caps.service-boundary-core.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!-- provided: the kernel that hosts the cap supplies the SPI, and the jar keeps no runtime dependency -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-tck</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.exeris</groupId>
                            <artifactId>exeris-processor</artifactId>
                            <version>${exeris.tooling.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-codegen-maven-plugin</artifactId>
                <version>${exeris.tooling.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                            <goal>verify-capabilities</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>
</project>
